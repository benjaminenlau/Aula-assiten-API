# Copiar como .env en el directorio desde el que se inicia la API.
# Las variables del sistema tienen prioridad sobre este archivo.
AULA_DB_URL=jdbc:postgresql://localhost:5432/postgres
AULA_DB_USER=postgres
AULA_DB_PASSWORD="REEMPLAZAR_CON_LA_CONTRASENA_LOCAL"

# Configurar para crear el primer administrador (sin valores predeterminados).
# Contrasena de entre 12 y 128 caracteres. No se vuelve a aplicar si ya existe un ADMIN.
# AULA_BOOTSTRAP_ADMIN_USER=administrador
# AULA_BOOTSTRAP_ADMIN_PASSWORD="REEMPLAZAR_CON_UNA_CONTRASENA_SEGURA"
